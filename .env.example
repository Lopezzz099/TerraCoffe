# Opcionales. Copiá este archivo a .env.local si querés usarlas.

# Dominio propio, para las vistas previas al compartir (Open Graph).
# En Vercel, si no se define, se usa el dominio de producción del proyecto.
# NEXT_PUBLIC_SITE_URL=https://www.ejemplo.com

# Solo si el sitio se publica en un subdirectorio. En Vercel no se usa.
# NEXT_PUBLIC_BASE_PATH=
